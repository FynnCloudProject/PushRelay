ENVIRONMENT=production
HOSTNAME=0.0.0.0
PORT=8080
LOG_LEVEL=notice

APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=/run/secrets/apns_auth_key.p8
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_PRIVATE_KEY_BASE64=

APNS_ALLOWED_TOPICS=com.example.app
APNS_ALLOWED_VOIP_TOPICS=com.example.app.voip
APNS_ALLOWED_FILEPROVIDER_TOPICS=com.example.app.pushkit.fileprovider
APNS_ALLOW_SANDBOX=true

# Optional Bearer token for private single-tenant relays.
RELAY_SHARED_SECRET=
TRUST_PROXY_HEADERS=false
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_TOKEN_PER_MINUTE=120

# Optional metrics web UI at /admin (disabled unless ADMIN_PASSWORD is set, min 12 chars).
# When set, ADMIN_PASSWORD also authorizes Bearer scrapes on /metrics and /admin/metrics.
ADMIN_PASSWORD=
# Optional dedicated Bearer token for Prometheus scrapes on GET /metrics (works with or without /admin).
METRICS_BEARER_TOKEN=
# Set false only for local HTTP development without TLS.
ADMIN_COOKIE_SECURE=true
